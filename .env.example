POSTGRES_DB=sharepier
POSTGRES_USER=sharepier
POSTGRES_PASSWORD=sharepier
DATABASE_URL=postgres://sharepier:sharepier@postgres:5432/sharepier?sslmode=disable
SHAREPIER_ENV=development
SHAREPIER_HOST=0.0.0.0
SHAREPIER_PORT=8080
SHAREPIER_API_HOST_PORT=38080
SHAREPIER_WEB_HOST_PORT=3300
SHAREPIER_MIGRATIONS_DIR=./migrations
SHAREPIER_SESSION_COOKIE_NAME=sharepier_session
SHAREPIER_SESSION_TTL=168h
SHAREPIER_SECURE_COOKIES=false
SHAREPIER_SHARE_ACCESS_COOKIE_NAME=sharepier_public_access
SHAREPIER_SHARE_ACCESS_SECRET=change-me-share-access-secret
SHAREPIER_SHARE_ACCESS_TTL=12h
SHAREPIER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300,http://localhost:5173,http://127.0.0.1:5173
SHAREPIER_STORAGE_BACKEND=local
PGDATA=/var/lib/postgresql/data/pgdata
SHAREPIER_STORAGE_ROOT=/data/storage
SHAREPIER_STORAGE_QUOTA_BYTES=0
SHAREPIER_S3_ENDPOINT=
SHAREPIER_S3_REGION=
SHAREPIER_S3_BUCKET=
SHAREPIER_S3_ACCESS_KEY_ID=
SHAREPIER_S3_SECRET_ACCESS_KEY=
SHAREPIER_S3_USE_SSL=true
SHAREPIER_S3_USE_PATH_STYLE=false
SHAREPIER_S3_PREFIX=
SHAREPIER_S3_AUTO_CREATE_BUCKET=true
SHAREPIER_PUBLIC_BASE_URL=http://localhost:38080
SHAREPIER_MAX_UPLOAD_SIZE=104857600
SHAREPIER_RESUMABLE_CHUNK_SIZE=8388608
SHAREPIER_UPLOAD_SESSION_TTL=24h
SHAREPIER_ADMIN_USERNAME=admin
SHAREPIER_ADMIN_PASSWORD=change-me-now
MINIO_ROOT_USER=sharepierminio
MINIO_ROOT_PASSWORD=sharepierminiosecret
DOCKER_GOPROXY=https://goproxy.cn,direct
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
VITE_API_BASE_URL=http://localhost:38080
